# ─────────────────────────────────────────────────────────────────────────────
# 금융 AI Agent – 환경변수 예시 (.env.example)
# 복사: cp .env.example .env  또는  cp .env.example .env.dev
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=8000

# ── JWT 인증 (API 클라이언트 / 모바일용) ──────────────────────────────────────
# 최소 32자 이상의 무작위 문자열 권장: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-32chars-min!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900        # 액세스 토큰 유효 시간 (초, 기본 15분)
JWT_REFRESH_TTL=604800    # 리프레시 토큰 유효 시간 (초, 기본 7일)

# Ollama (local LLM + embeddings + VLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text
VLM_MODEL=llava          # 이미지/슬라이드 설명용 비전 모델 (ollama pull llava)

# ── LLM 서빙 백엔드 (채팅/에이전트 전용 — 임베딩은 항상 위 Ollama 설정을 사용) ──
# ollama(기본) | bedrock | sagemaker | vllm
LLM_PROVIDER=ollama

# Bedrock (LLM_PROVIDER=bedrock 일 때 필요, AWS_REGION 공용)
# 리전별로 모델 가용성이 다름 — 예: Meta Llama는 us-east-1/us-west-2, 서울 리전엔 없음.
BEDROCK_MODEL_ID=

# SageMaker JumpStart 채팅 엔드포인트 (LLM_PROVIDER=sagemaker 일 때 필요)
# 배포: python sagemaker/deploy_llm_endpoint.py deploy --execution-role <role-arn>
SAGEMAKER_ENDPOINT_NAME=

# OpenAI API – 로보 어드바이저 채팅 우측 상단 "OpenAI API Key 입력으로 사용" 모드.
# 키는 브라우저가 요청마다 보내고 서버에는 저장하지 않는다. OPENAI_API_KEY 는 요청에 키가 없을 때의 서버 기본값(선택).
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# EC2/ECS 위의 vLLM, OpenAI 호환 서버 (LLM_PROVIDER=vllm 일 때 필요)
VLLM_BASE_URL=
VLLM_MODEL=

# PostgreSQL (사용자 인증, CB 통계, 금융상품, 채팅, 포트폴리오, 주문 등 전체 영속 데이터)
DATABASE_URL=postgresql+asyncpg://fin_user:fin_pass@localhost:5432/fin_ai

# Redis (세션)
REDIS_URL=redis://localhost:6379
# 세션 유효 기간(초). 슬라이딩 만료라 마지막 활동 후 이 시간이 지나야 로그아웃된다. 기본 30일.
SESSION_TTL=2592000
# 슬라이딩 갱신 최소 간격(초). 이 간격마다 1회만 Redis TTL 과 브라우저 쿠키 만료를 연장한다.
SESSION_REFRESH_INTERVAL=300

# 금융 CSV 데이터 경로 (디렉토리)
DATA_DIR=./data

# Qdrant (벡터 DB)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fin_chunks

# RAG 설정
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=6

# 관리자 이메일 (쉼표 구분)
ADMIN_EMAILS=

# GitHub API (크롤링용 – rate limit 증가)
GITHUB_TOKEN=

# 쿠키 보안
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# 증권사 Open API (설정 후 UI에서도 변경 가능)
# ─────────────────────────────────────────────────────────────────────────────

# 한국투자증권 (KIS) Open API
# 신청: https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# true=모의투자, false=실전투자
KIS_PAPER=true

# LS증권 eBest Open API
# 신청: https://openapi.ebestsec.co.kr/
EBEST_APP_KEY=
EBEST_APP_SECRET=
EBEST_ACCOUNT_NO=

# ─────────────────────────────────────────────────────────────────────────────
# 알림 채널 설정 (선택 – 필요한 채널만 설정하세요)
# 설정된 채널로 매매 성공/실패 알림이 자동 발송됩니다.
# UI의 [알림 설정] 탭에서 사용자별로도 변경할 수 있습니다.
# ─────────────────────────────────────────────────────────────────────────────

# 텔레그램 (선택)
# 1. BotFather 에서 봇 생성 후 토큰 발급: /newbot
# 2. 채팅 ID 확인: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Incoming Webhook (선택)
# 1. https://api.slack.com/apps → 앱 생성 → Incoming Webhooks 활성화
# 2. 채널 추가 후 Webhook URL 복사
SLACK_WEBHOOK_URL=

# 이메일 알림 (선택, SMTP / STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# 카카오 알림톡 (선택, CoolSMS API)
# 신청: https://coolsms.co.kr/
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
KAKAO_SENDER_KEY=   # 카카오 채널 발신 프로필 키
KAKAO_PHONE=        # 수신 전화번호 (예: 01012345678)

# SMS 문자 알림 (선택, CoolSMS API – COOLSMS_API_KEY/SECRET 공용)
SMS_FROM=           # 발신 번호 (CoolSMS 등록 번호)
SMS_TO=             # 수신 번호

# ── AWS (선택 — 없으면 관련 기능만 자동으로 비활성화되고 나머지는 정상 동작) ──
# Comprehend 뉴스 감성분석 / SageMaker 배치 학습 결과(S3 scores.json) 조회.
# 로컬 개발 환경에선 보통 비워둔다 — EC2 배포 시 인스턴스 프로파일로 자격증명 자동 주입.
AWS_REGION=ap-northeast-2

# ── KIS(한국투자증권) 자격증명 — 서버 관리 (app/services/kis_credentials.py) ──
# 사용자는 종목 선정 화면에서 증권사 KIS 를 고르기만 하고 App Key/Secret/계좌는 입력하지 않는다.
# 운영: Secrets Manager 시크릿 이름(또는 ARN). 값은 JSON {"app_key","app_secret","account_no","environment":"paper|real"}
#       EC2/ECS 역할에 secretsmanager:GetSecretValue 권한 필요. 화면에는 연동 여부·계좌 마스킹·환경만 표시된다.
KIS_SECRETS_NAME=
KIS_SECRETS_CACHE_TTL=600
KIS_ENVIRONMENT=paper
# 로컬 개발·장애 시 폴백 (운영에서는 비워 둔다)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
ML_ARTIFACTS_BUCKET=       # 예: lumina-ml-artifacts-<account_id>-ap-northeast-2

# ── 모의투자 Open API (/openapi/v1) — stock-coin-trade 이식 ─────────────────────
# 키는 앱의 [모의투자 > Open API] 화면에서 발급. 키당 분당 호출 제한.
OPENAPI_RATE_LIMIT_MAX=60
OPENAPI_RATE_LIMIT_WINDOW=60

# ── Alpaca Paper Trading (읽기 전용 연결 테스트 + 퀀트 파이프라인 주문) ───────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── QuantConnect LEAN 백테스트 — domain-rag-lab / stock-coin-trade 이식 ───────────
# auto | ssh | docker | local
#   auto   : LEAN_SSH_HOST가 있으면 ssh → docker CLI 또는 /var/run/docker.sock 있으면 docker → 그 외 local
#   docker : 같은 호스트의 Docker 데몬에서 quantconnect/lean 컨테이너 실행 (docker pull quantconnect/lean 필요, ~14GB)
#   ssh    : 원격 서버(EC2 등)에 scp 후 docker run (PEM 키는 저장소에 넣지 말고 읽기 전용 마운트)
#   local  : LEAN을 실행하지 않고 pandas 계산만 (LEAN 미설치 환경)
LEAN_MODE=auto
LEAN_DOCKER_IMAGE=quantconnect/lean:latest
LEAN_TIMEOUT_SECONDS=300
LEAN_KEEP_WORKDIR=false
# docker 모드: 앱이 쓰는 작업 폴더. docker-compose에서는 named volume(lean-workflows)을 마운트해 넘긴다.
LEAN_WORKDIR=./data/lean-workflows
LEAN_DOCKER_VOLUME=
LEAN_HOST_WORKDIR=
# ssh 모드
LEAN_SSH_HOST=
LEAN_SSH_USER=ubuntu
LEAN_SSH_KEY_PATH=
LEAN_REMOTE_WORKDIR=/home/ubuntu/lean-workflows

# ── KIS 모의투자(Testbed) 백그라운드 배치 (app/services/kis_batch.py) ──────────────
# true 면 celery-beat 가 QUANT_CYCLE_SEC(기본 3분)마다 시스템 사용자 행으로 자동매매를 돌린다. 로그인·대시보드 버튼 불필요.
# 실주문 경로(STOCK_COIN_TRADE_* 또는 KIS_SECRETS_NAME)가 paper 일 때만 켜진다. real 이면 켜지지 않는다.
# 비상 정지(kill switch) 후에는 자동 재가동하지 않는다. 끄려면 false 로 바꾸고 재기동(다음 사이클에 해제).
KIS_PAPER_BATCH_ENABLED=false
KIS_PAPER_BATCH_SYMBOLS=           # 비우면 AI 추천 상위 N. 예: 005930.KS,035720.KS
KIS_PAPER_BATCH_AI_TOP_N=3
KIS_PAPER_BATCH_PER_TRADE_BUDGET=500000   # 1회 투자금(원). 배치 행(시스템 사용자)은 매 사이클 이 값으로 맞춰진다
# true 면 배치가 도는 동안 사용자 계정의 kis·live 자동매매를 끈다(공용 Testbed 계좌 단독 사용). 기본 false = 사용자도 KIS 모의투자 가능
KIS_PAPER_BATCH_EXCLUSIVE=false

# ── 자동매매 사이클 주기(초). beat 스케줄·time_limit·화면 문구가 따른다. 2026-10-07: 300 → 180 ──
QUANT_CYCLE_SEC=180

# ── 공격 모드: 5분봉 단기 시그널로 매 사이클 매수·매도 (app/services/aggressive_mode.py) ──────────
# true 면 일봉 대신 5분봉 지표. 매 사이클 모멘텀 상위 매수(시그널 없으면 1위 로테이션), 보유분은 익절/손절/약세 매도.
# 쿨다운·일 주문 수는 아래 값으로 덮어쓴다. 종목 비중·일손실 한도·비상 정지는 종목 선정 화면 값 그대로.
QUANT_AGGRESSIVE_MODE=false
QUANT_AGGRESSIVE_CANDLE_INTERVAL=5m
QUANT_AGGRESSIVE_CANDLE_RANGE=5d
QUANT_AGGRESSIVE_CACHE_MIN=2
QUANT_AGGRESSIVE_COOLDOWN_MIN=3
QUANT_AGGRESSIVE_MAX_ORDERS_PER_DAY=300
QUANT_AGGRESSIVE_MAX_BUYS_PER_CYCLE=2
QUANT_AGGRESSIVE_MAX_SELLS_PER_CYCLE=3
QUANT_AGGRESSIVE_FORCE_BUY=true
QUANT_AGGRESSIVE_TAKE_PROFIT_PCT=1.5
QUANT_AGGRESSIVE_STOP_LOSS_PCT=1.0
QUANT_AGGRESSIVE_ORDER_TYPE=MARKET

# ── 시세 소스 (app/services/kis_market_data.py) ─────────────────────────────────────────────
# kis: 국내(.KS/.KQ) 일봉·분봉·현재가를 stock-coin-trade 의 KIS 차트 API(/api/kis-chart) 로 받는다(실시간).
# yahoo: 기존 Yahoo Finance(국내 분봉 ~20분 지연, 요청 제한). KIS 실패 시 폴백 여부는 MARKET_DATA_FALLBACK_YAHOO.
MARKET_DATA_SOURCE=kis
MARKET_DATA_FALLBACK_YAHOO=true
KIS_CHART_TIMEOUT=10
KIS_CHART_MINUTES=240

# ── 정합성 점검: 로그 vs KIS 실거래 (app/services/reconciliation.py, beat quant.reconcile) ──────
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SEC=600
RECONCILE_OPEN_ORDER_MAX_MIN=30
RECONCILE_SLIPPAGE_ALERT_PCT=1.0
RECONCILE_NOTIFY=true
