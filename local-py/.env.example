# local-py 자동매매 설정 — 이 파일을 .env 로 복사해서 쓴다. 전부 선택이며, 없으면 기본값으로 돈다.
# CLI 인자가 .env 보다 우선한다 (예: python trade.py cycle --source mock).

# ── 실행 ──────────────────────────────────────────────────────────────
QUANT_MODE=paper              # paper = 로컬 가상장부만 / live = KIS 실주문까지
MARKET_DATA_SOURCE=yahoo      # yahoo | kis | mock(오프라인 테스트)
QUANT_CYCLE_SEC=180           # loop 명령의 사이클 주기(초)
LOCAL_USER_ID=local           # 상태 파일 안에서 계정을 구분하는 키
# LOCAL_DATA_DIR=/path/to/data

# ── 종목 선정 ─────────────────────────────────────────────────────────
QUANT_SYMBOL_SOURCE=ai        # ai = 점수 상위 N / manual = QUANT_SELECTED_SYMBOLS
QUANT_AI_TOP_N=3
# QUANT_SELECTED_SYMBOLS=005930.KS,000660.KS
# QUANT_STRATEGY_ID=ma-cross-basic    # strategies/<id>.json
QUANT_CANDLE_PERIOD=2y
QUANT_CANDLE_CACHE_HOURS=6

# ── 주문 크기 ─────────────────────────────────────────────────────────
QUANT_INITIAL_CAPITAL=10000000
QUANT_PER_TRADE_BUDGET=1000000
QUANT_BUY_RATIO=1.0
QUANT_SELL_RATIO=0.5

# ── 위험관리 ──────────────────────────────────────────────────────────
RISK_DAILY_LOSS_LIMIT_PCT=3.0     # 당일 시작자산 대비 -N% 면 비상 정지
RISK_MAX_POSITION_PCT=30.0        # 한 종목이 총자산의 N% 를 넘지 않게 수량 축소
RISK_MAX_ORDERS_PER_DAY=20
RISK_COOLDOWN_MIN=30              # 같은 종목·방향 재주문 간격(분)

# ── 공격 모드(분봉 단기) ──────────────────────────────────────────────
QUANT_AGGRESSIVE_MODE=false
QUANT_AGGRESSIVE_CANDLE_INTERVAL=5m
QUANT_AGGRESSIVE_CANDLE_RANGE=5d
QUANT_AGGRESSIVE_CACHE_MIN=2
QUANT_AGGRESSIVE_COOLDOWN_MIN=3
QUANT_AGGRESSIVE_MAX_ORDERS_PER_DAY=300
QUANT_AGGRESSIVE_MAX_BUYS_PER_CYCLE=2
QUANT_AGGRESSIVE_MAX_SELLS_PER_CYCLE=3
QUANT_AGGRESSIVE_FORCE_BUY=true
QUANT_AGGRESSIVE_TAKE_PROFIT_PCT=1.5
QUANT_AGGRESSIVE_STOP_LOSS_PCT=1.0

# ── KIS Open API (live 모드 / MARKET_DATA_SOURCE=kis 일 때만) ─────────
# 모의투자 키로 먼저 확인할 것. KIS_PAPER=false 는 실제 돈이 나간다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=              # 8자리 계좌 + 2자리 상품코드 (예: 5012345601)
KIS_PAPER=true
KIS_ENFORCE_MARKET_HOURS=true
HTTP_TIMEOUT=15
